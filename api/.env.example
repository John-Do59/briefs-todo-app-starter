# Environment
ENVIRONMENT=development  # or "production"

# API database URL (defaults to local SQLite if unset)
# SQLite (no extra service required):
DATABASE_URL=sqlite:///./todo.db

# PostgreSQL (uncomment to override):
# DATABASE_URL=postgresql://todouser:todopassword@localhost:5432/tododb

# Authentication
SECRET_KEY=your-secret-key-change-this-in-production-please-use-a-long-random-string
ACCESS_TOKEN_EXPIRE_MINUTES=30
